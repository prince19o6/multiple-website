# ==============================================================================
# Multi-Website Travel Platform - Environment Template
# ==============================================================================
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_DEFAULT_LANG=en

# Choose which website to display directly on http://localhost:3000:
# Allowed values: gujjutours | tripgoasia | technoheaven
SITE_ID=tripgoasia

# Optional: set to true to allow gujjutours.localhost:3000 style host routing
# Defaults to false so SITE_ID in this file directly controls localhost:3000
ENABLE_HOST_ROUTING=false
