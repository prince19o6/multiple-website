# ==============================================================================
# Multi-Website Travel Platform - Web (Next.js 15) Environment Template
# ==============================================================================
PORT=3000

# ------------------------------------------------------------------------------
# 1. Multi-Tenant Website Selection
# ------------------------------------------------------------------------------
# Choose which brand website to run on http://localhost:3000:
# Allowed values: gujjutours | tripgoasia | technoheaven
SITE_ID=tripgoasia

# Optional multi-host local testing:
# When true, you can access each tenant via local subdomains:
#   - http://gujjutours.localhost:3000
#   - http://tripgoasia.localhost:3000
#   - http://technoheaven.localhost:3000
# Defaults to false so SITE_ID directly controls http://localhost:3000
ENABLE_HOST_ROUTING=false

# ------------------------------------------------------------------------------
# 2. Per-Website Server API Keys & Base URLs (Server-Only, No NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# In production, each deployment sets only its own tenant's variables.
# Gujju Tours
GUJJUTOURS_API_URL=
GUJJUTOURS_API_KEY=

# TripGo Asia
TRIPGOASIA_API_URL=
TRIPGOASIA_API_KEY=

# Technoheaven
TECHNOHEAVEN_API_URL=
TECHNOHEAVEN_API_KEY=

# ------------------------------------------------------------------------------
# 3. Global Backend Fallback (Development)
# ------------------------------------------------------------------------------
API_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SITE_ID=tripgoasia
NEXT_PUBLIC_API_KEY=tg_sec_live_web_tripgoasia_2026_k9p
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. Internationalization & Locale
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_LANG=en

# ------------------------------------------------------------------------------
# 5. Booking Workflow & Admin Portals
# ------------------------------------------------------------------------------
# Web Admin Booking Inbox: http://localhost:3000/admin/bookings
# Customer My Bookings:    http://localhost:3000/my-bookings
# Customer Booking Pass:   http://localhost:3000/booking/confirmation?ref={REF}
# 1-Tap Email Decisions:   http://localhost:3000/booking-action/[action]?token={TOKEN}
# Customer Register:       http://localhost:3000/en/register
# Customer Login:          http://localhost:3000/en/login
# Customer Account:        http://localhost:3000/en/account
