{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb+srv://<USER>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority",
    "TlsMode": "skip",
    "ServerSelectionTimeoutSeconds": 8
  },
  "Websites": {
    "gujjutours": {
      "DatabaseName": "tours_gujjutours",
      "JwtIssuer": "ToursApi-GujjuTours",
      "JwtAudience": "ToursApp-GujjuTours",
      "JwtSigningKey": "GujjuTours_Secret_Jwt_Signing_Key_2026_Secure_Minimum_256_Bits!",
      "AdminSeedSecret": "GujjuTours_Admin_Seed_Secret_2026_Secure!",
      "ActionTokenSecret": "GujjuTours_Action_Token_Secret_2026_Secure_Key_HMAC_SHA256!",
      "EmailFromAddress": "support@gujjutours.com",
      "EmailFromName": "Gujju Tours Concierge",
      "RequireApproval": true,
      "PendingExpiryHours": 48,
      "AdminNotificationEmails": [
        "admin@gujjutours.com",
        "operations@gujjutours.com"
      ]
    },
    "tripgoasia": {
      "DatabaseName": "tours_tripgoasia",
      "JwtIssuer": "ToursApi-TripGoAsia",
      "JwtAudience": "ToursApp-TripGoAsia",
      "JwtSigningKey": "TripGoAsia_Secret_Jwt_Signing_Key_2026_Secure_Minimum_256_Bits!",
      "AdminSeedSecret": "TripGoAsia_Admin_Seed_Secret_2026_Secure!",
      "ActionTokenSecret": "TripGoAsia_Action_Token_Secret_2026_Secure_Key_HMAC_SHA256!",
      "EmailFromAddress": "support@tripgoasia.com",
      "EmailFromName": "TripGo Asia Concierge",
      "RequireApproval": true,
      "PendingExpiryHours": 48,
      "AdminNotificationEmails": [
        "admin@tripgoasia.com",
        "reservations@tripgoasia.com"
      ]
    },
    "technoheaven": {
      "DatabaseName": "tours_technoheaven",
      "JwtIssuer": "ToursApi-Technoheaven",
      "JwtAudience": "ToursApp-Technoheaven",
      "JwtSigningKey": "Technoheaven_Secret_Jwt_Signing_Key_2026_Secure_Minimum_256_Bits!",
      "AdminSeedSecret": "Technoheaven_Admin_Seed_Secret_2026_Secure!",
      "ActionTokenSecret": "Technoheaven_Action_Token_Secret_2026_Secure_Key_HMAC_SHA256!",
      "EmailFromAddress": "support@technoheaven.com",
      "EmailFromName": "Technoheaven Luxury Desk",
      "RequireApproval": true,
      "PendingExpiryHours": 48,
      "AdminNotificationEmails": [
        "admin@technoheaven.com",
        "luxury@technoheaven.com"
      ]
    }
  },
  "Jwt": {
    "ExpiryMinutes": 60,
    "RefreshExpiryDays": 30
  },
  "Email": {
    "Provider": "Dev",
    "DevEmailFolder": "dev-emails",
    "EnableSmtp": false,
    "SmtpHost": "smtp.example.com",
    "SmtpPort": 587,
    "User": "smtp-user",
    "Password": "smtp-password",
    "EnableSsl": true,
    "SendGridApiKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3001",
      "http://localhost:8081",
      "http://127.0.0.1:3000"
    ]
  },
  "ExternalConfig": {
    "Enabled": true,
    "BaseUrls": {
      "gujjutours": "https://stagingapi.gujjutours.com",
      "tripgoasia": "https://stagingapi.tripgoasia.com",
      "technoheaven": "https://stagingapi.technoheaven.com"
    }
  }
