{
  "cli": {
    "version": ">= 12.0.0",
    "promptToInstall": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "gradleCommand": ":app:assembleDebug",
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "http://localhost:5000",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "development:gujjutours": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "http://localhost:5000",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "development:tripgoasia": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "tripgoasia",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.tripgoasia.com",
        "EXPO_PUBLIC_API_URL": "http://localhost:5000",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.tripgoasia.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "development:technoheaven": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "technoheaven",
        "EXPO_PUBLIC_SITE_HOSTNAME": "stagingb2b.technoheaven.com",
        "EXPO_PUBLIC_API_URL": "http://localhost:5000",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.technoheaven.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "https://api.gujjutours.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "preview:gujjutours": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "https://api.gujjutours.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "preview:tripgoasia": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "tripgoasia",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.tripgoasia.com",
        "EXPO_PUBLIC_API_URL": "https://api.tripgoasia.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.tripgoasia.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "preview:technoheaven": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "technoheaven",
        "EXPO_PUBLIC_SITE_HOSTNAME": "stagingb2b.technoheaven.com",
        "EXPO_PUBLIC_API_URL": "https://api.technoheaven.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.technoheaven.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "https://api.gujjutours.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "production:gujjutours": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "gujjutours",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.gujjutours.com",
        "EXPO_PUBLIC_API_URL": "https://api.gujjutours.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.gujjutours.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "production:tripgoasia": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "tripgoasia",
        "EXPO_PUBLIC_SITE_HOSTNAME": "www.tripgoasia.com",
        "EXPO_PUBLIC_API_URL": "https://api.tripgoasia.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.tripgoasia.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    },
    "production:technoheaven": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_SITE_ID": "technoheaven",
        "EXPO_PUBLIC_SITE_HOSTNAME": "stagingb2b.technoheaven.com",
        "EXPO_PUBLIC_API_URL": "https://api.technoheaven.com",
        "EXPO_PUBLIC_CONFIG_API_URL": "https://stagingapi.technoheaven.com",
        "EXPO_PUBLIC_DEFAULT_LANG": "en"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "your@apple.id",
        "ascAppId": "YOUR_ASC_APP_ID",
        "appleTeamId": "YOUR_TEAM_ID"
      }
    }
  }
}
