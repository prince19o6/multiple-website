# ==============================================================================
# Multi-Tenant Travel App - Mobile (Expo SDK) Environment Variables Template
# ==============================================================================
# All EXPO_PUBLIC_* variables are inlined at bundle time.
# NEVER store private secrets or sensitive credentials in these variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Active Website Identity
# ------------------------------------------------------------------------------
# Site identifier: gujjutours | tripgoasia | technoheaven
EXPO_PUBLIC_SITE_ID=gujjutours

# Canonical domain hostname (matches backend WebsiteRegistry.cs and Web app)
# Options:
#   - www.gujjutours.com            (Gujju Tours)
#   - www.tripgoasia.com            (TripGo Asia)
#   - stagingb2b.technoheaven.com   (Technoheaven)
EXPO_PUBLIC_SITE_HOSTNAME=www.gujjutours.com

# Low-privilege public app key for mobile read-only endpoints (config, catalog)
# Rotatable per build without private server secret exposure.
EXPO_PUBLIC_APP_KEY=

# ------------------------------------------------------------------------------
# 2. Config & Backend APIs
# ------------------------------------------------------------------------------
# Base URL for the site-specific external configuration API endpoint:
# {EXPO_PUBLIC_CONFIG_API_URL}/api/core/v1/config/{HOSTNAME}?lang=en
# Staging endpoints per website:
#   - GujjuTours:    https://stagingapi.gujjutours.com
#   - TripGoAsia:    https://stagingapi.tripgoasia.com
#   - Technoheaven:  https://stagingapi.technoheaven.com
EXPO_PUBLIC_CONFIG_API_URL=https://stagingapi.gujjutours.com

# Base URL of the data backend (tours, bookings, auth).
# Defaults to staging config API URL.
EXPO_PUBLIC_API_URL=https://stagingapi.gujjutours.com

# Set to true when developing against local ASP.NET Core backend (port 5000):
# When true, requests are routed to http://localhost:5000 (or physical LAN IP via Expo)
# with the X-Website-Hostname header attached automatically.
# Or pass --backend flag: npm start -- --backend
EXPO_PUBLIC_USE_LOCAL_BACKEND=true

# Optional secondary fallback URL if primary API fails
EXPO_PUBLIC_BACKEND_FALLBACK_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. Localization
# ------------------------------------------------------------------------------
# Default language code passed to the config API and data queries (default: en)
EXPO_PUBLIC_DEFAULT_LANG=en

# ------------------------------------------------------------------------------
# 4. Developer Diagnostics & Overrides
# ------------------------------------------------------------------------------
# Set to true to enable the in-app brand site switcher modal (development only)
EXPO_PUBLIC_ENABLE_SITE_SWITCHER=true

# ------------------------------------------------------------------------------
# 5. Mobile Booking Workflow Features
# ------------------------------------------------------------------------------
# Customer Bookings Tab: (tabs)/bookings (Status segment filter: All, Pending, Confirmed, Cancelled)
# Booking Confirmation Pass: booking/confirmation?ref={REF}
