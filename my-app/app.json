{
  "expo": {
    "name": "ToursApp",
    "slug": "toursapp",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "toursapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toursapp.multisite",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access for uploading photos and scanning booking passes in the app.",
        "NSPhotoLibraryUsageDescription": "Allow photo access for selecting traveler documentation in the app.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to show nearby tours and destination weather in the app."
      }
    },
    "android": {
      "package": "com.toursapp.multisite",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "androidNavigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ]
  }
}
