{
  "expo": {
    "name": "Multi Site",
    "slug": "multi-site-app",
    "version": "1.0.0",
    "sdkVersion": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "multisite",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.multisite",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access for uploading photos on the websites.",
        "NSPhotoLibraryUsageDescription": "Allow photo access for uploading images on the websites.",
        "NSLocationWhenInUseUsageDescription": "Allow location access for location-based features on the websites."
      }
    },
    "android": {
      "package": "com.yourcompany.multisite",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "androidNavigationBar": {
        "backgroundColor": "#ffffff",
        "barStyle": "dark-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B0F19"
          }
        }
      ],
      "expo-web-browser",
      "expo-status-bar"
    ]
  }
}
